  "dependencies": {
    "@react-oauth/google": "^0.12.1",
    "chart.js": "^4.5.0",
    "framer-motion": "^12.4.4",
    "gh-pages": "^6.3.0",
    "jwt-decode": "^4.0.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
