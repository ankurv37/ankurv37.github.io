  "scripts": {
    "predeploy": "npm run setup:wasm && npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "npm run build:wasm && npm run build:chaos && react-scripts build",
    "build:wasm": "set GOOS=js&& set GOARCH=wasm&& go build -o public/main.wasm main.go",
    "build:chaos": "set GOOS=js&& set GOARCH=wasm&& go build -o public/chaos.wasm chaos.go",
    "copy:wasm": "copy  \"C:\\Program Files\\Go\\misc\\wasm\\wasm_exec.js\" public\\",
    "setup:wasm": "npm run build:wasm && npm run build:chaos && npm run copy:wasm",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
